# Copy to .env and fill in. Never commit .env.

# --- app ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=["http://localhost:3000"]

# --- storage (defaults: ./data/app.sqlite and ./data) ---
# DATABASE_URL=postgresql+psycopg://askdata:askdata@localhost:5432/askdata
# DATA_DIR=./data

# --- auth ---
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# --- llm ---
# auto = use Anthropic when ANTHROPIC_API_KEY is set, otherwise the deterministic mock
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL_STRONG=claude-opus-5-5
LLM_MODEL_FAST=claude-haiku-5-5
LLM_EFFORT_STRONG=medium
LLM_EFFORT_FAST=low

# --- limits ---
MAX_UPLOAD_MB=50
QUERY_TIMEOUT_S=10
QUERY_ROW_CAP=1000
RATE_LIMIT_PER_MIN=30
DAILY_COST_CAP_USD=1.0

# --- observability ---
SENTRY_DSN=

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
