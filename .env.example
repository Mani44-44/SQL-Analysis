# Copy to .env and fill in. Never commit .env.

# --- app ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=["http://localhost:3000"]

# --- storage (defaults: ./data/app.sqlite and ./data) ---
# DATABASE_URL=postgresql+psycopg://askdata:askdata@localhost:5432/askdata
# DATA_DIR=./data

# --- auth ---
# at least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
COOKIE_SECURE=false
# lax when UI and API share a site (localhost:3000 -> :8000); none (+ COOKIE_SECURE=true) across sites
COOKIE_SAMESITE=lax

# --- llm ---
# auto = use Anthropic when ANTHROPIC_API_KEY is set, otherwise the deterministic mock; ollama = local model
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL_STRONG=claude-opus-5-5
LLM_MODEL_FAST=claude-haiku-5-5
LLM_EFFORT_STRONG=medium
LLM_EFFORT_FAST=low

# --- local models (LLM_PROVIDER=ollama, or `--provider ollama` for the benchmark) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_THINK=false        # true = let the model reason first (slower, often more accurate)
# OLLAMA_NUM_CTX=6144

# --- limits ---
MAX_UPLOAD_MB=50
QUERY_TIMEOUT_S=10
QUERY_ROW_CAP=1000
RATE_LIMIT_PER_MIN=30
DAILY_COST_CAP_USD=1.0
# reverse proxies that append to X-Forwarded-For (0 = ignore the header; 1 on Fly/Render)
TRUSTED_PROXY_HOPS=0

# --- observability ---
SENTRY_DSN=

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
